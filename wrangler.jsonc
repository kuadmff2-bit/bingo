{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bingo",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-11",
  "keep_vars": true,
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
