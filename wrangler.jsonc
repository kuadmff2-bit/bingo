{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bingo",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-11",
  "keep_vars": true,
  "vars": {
    "ADMIN_EMAIL": "kuadmff2@gmail.com",
    "ADMIN_NAME": "Carlos",
    "ORGANIZATION_NAME": "BINGASSO DO EL GATO",
    "ALLOW_PUBLIC_REGISTRATION": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bingo-facil-db",
      "database_id": "6b4bb2d3-0881-466e-84dc-2ccf6e81db3b"
    }
  ],
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
